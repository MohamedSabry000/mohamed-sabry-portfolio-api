OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
CHAT_RATE_LIMIT=20
PORT=8787
# Front-end origins allowed to call the API (comma-separated)
CORS_ORIGINS=https://mohamedsabry000.github.io,http://localhost:5173

# Sanity CMS for the AI assistant (optional)
SANITY_PROJECT_ID=rdln7m0z
SANITY_DATASET=production
# Only needed if the dataset is private
SANITY_READ_TOKEN=
# Editor token: enables saving visitor chats to Sanity
SANITY_WRITE_TOKEN=
SANITY_CACHE_SECONDS=60

# --- MongoDB backend (portfolio content, contact messages, chat logs, admin login) ---
MONGODB_URI=mongodb://localhost:27017/portfolio
# Long random string used to sign admin login tokens
JWT_SECRET=change-me
# First admin account, created on first start if none exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
