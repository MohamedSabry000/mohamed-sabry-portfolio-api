{
  "name": "mohamed-sabry-portfolio-api",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js + Express + MongoDB backend for Mohamed Sabry's portfolio",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
